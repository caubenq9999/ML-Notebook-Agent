# Chỉ bật một provider cho mỗi lần chạy. Không điền key thật vào file này.

# Groq (mặc định)
GROQ_API_KEY=

# Gemini
GEMINI_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# DeepSeek official API
DEEPSEEK_API_KEY=

# AgentRouter (custom Python client cần được AgentRouter whitelist)
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://agentrouter.org/v1

NOTEBOOKFORGE_PROVIDER=groq
NOTEBOOKFORGE_MODEL=openai/gpt-oss-120b
# Phải khác worker để giảm self-bias.
NOTEBOOKFORGE_MODEL_JUDGE=qwen/qwen3.6-27b

# 10000 đủ cho pilot DeepSeek; đây là trần output, model có thể dừng sớm.
NOTEBOOKFORGE_MAX_TOKENS=16000
NOTEBOOKFORGE_NOTEBOOK_MAX_TOKENS=10000

# DeepSeek: disabled ổn định/rẻ hơn; enabled cho phép reasoning_effort.
NOTEBOOKFORGE_DEEPSEEK_THINKING=disabled
